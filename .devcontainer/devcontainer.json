{
  "name": "Flux System in Rust",
  "dockerFile": "Dockerfile",
  "context": "../",
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "python.autoComplete.extraPaths": [
          "/usr/local/lib/flux/python3.8",
          "/usr/local/lib/python3.8/site-packages",
          "/workspaces/flux-core/src/bindings/python"
        ],
        "python.analysis.extraPaths": [
          "/usr/local/lib/flux/python3.8",
          "/usr/local/lib/python3.8/site-packages",
          "/workspaces/flux-core/src/bindings/python"
        ],
        "rust-analyzer.cargo.features": [
          "flux-core/tokio",
          "flux-core/smol",
          "flux-core/jobtap"
        ]
      },
      "extensions": [
        "ms-vscode.cpptools",
        "sumneko.lua",
        "ms-python.python",
        "rust-lang.rust-analyzer",
        "tamasfe.even-better-toml"
      ]
    }
  },
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {
      "version": "latest"
    }
  },
  "mounts": [
    "source=${localWorkspaceFolder}/.devcontainer/certs,target=/usr/local/share/ca-certificates/extra,type=bind,consistency=cached"
  ],
  "postCreateCommand": "bash .devcontainer/postCreate.sh",
  "waitFor": "postCreateCommand",
  "postStartCommand": "git config --global --add safe.directory /workspaces/flux-core-rs"
}
